{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "service-config.schema.json",
  "title": "ZED Agent Service Configuration",
  "description": "Normalized configuration schema for ZED Agent multi-service release automation (v1.0).",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "service",
    "serviceTreeIds",
    "ado",
    "kusto",
    "commitExcel",
    "sharepoint",
    "notifications",
    "safefly",
    "operational",
    "stepGates"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "default": "./service-config.schema.json",
      "description": "Pointer to this schema file for editor validation."
    },
    "version": {
      "type": "string",
      "description": "Schema version. Currently '1.0'.",
      "enum": ["1.0"],
      "default": "1.0"
    },

    "service": {
      "type": "object",
      "description": "Identity metadata for the service being released.",
      "required": ["name", "displayName"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "description": "Short canonical service name (e.g. 'Prot', 'MAB').",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "description": "Human-readable service name (e.g. 'Protection Service').",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Brief description of the service release purpose."
        }
      }
    },

    "serviceTreeIds": {
      "type": "object",
      "description": "Service Tree GUIDs used by SafeFly and EV2.",
      "required": ["safefly", "ev2"],
      "additionalProperties": true,
      "properties": {
        "safefly": {
          "type": "string",
          "description": "Service Tree GUID for SafeFly registration.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "ev2": {
          "type": "object",
          "description": "Service Tree GUIDs keyed by EV2 environment (Prod, Fairfax, Mooncake, etc.).",
          "required": ["Prod"],
          "additionalProperties": true,
          "properties": {
            "Prod": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "Fairfax": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "Mooncake": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          }
        }
      }
    },

    "ado": {
      "type": "object",
      "description": "Azure DevOps coordinates for the source repository.",
      "required": ["organization", "project", "repository", "branchPrefix", "baseBranch"],
      "additionalProperties": true,
      "properties": {
        "organization": {
          "type": "string",
          "description": "ADO organization name.",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "description": "ADO project name.",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "description": "ADO repository name.",
          "minLength": 1
        },
        "branchPrefix": {
          "type": "string",
          "description": "Prefix for official release branches (e.g. 'official/bdp-').",
          "minLength": 1
        },
        "baseBranch": {
          "type": "string",
          "description": "Base branch from which release branches are cut.",
          "default": "develop",
          "minLength": 1
        }
      }
    },

    "kusto": {
      "type": "object",
      "description": "Kusto query configuration for BVT and canary monitoring.",
      "required": ["bvt", "canary"],
      "additionalProperties": true,
      "properties": {
        "bvt": {
          "type": "object",
          "description": "BVT (Build Verification Test) Kusto query settings.",
          "required": ["cluster", "database", "queryFile"],
          "additionalProperties": true,
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Kusto cluster URL.",
              "format": "uri"
            },
            "database": {
              "type": "string",
              "description": "Kusto database name.",
              "minLength": 1
            },
            "queryFile": {
              "type": "string",
              "description": "Filename of the KQL query template.",
              "minLength": 1
            },
            "queryVariables": {
              "type": "object",
              "description": "Key-value pairs substituted into the KQL query template.",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "canary": {
          "type": "object",
          "description": "Canary health monitoring Kusto query settings.",
          "required": ["cluster", "database", "serviceFilter", "queryFile"],
          "additionalProperties": true,
          "properties": {
            "cluster": {
              "type": "string",
              "description": "Kusto cluster URL.",
              "format": "uri"
            },
            "database": {
              "type": "string",
              "description": "Kusto database name.",
              "minLength": 1
            },
            "serviceFilter": {
              "type": "string",
              "description": "KQL where-clause fragment to filter by service.",
              "minLength": 1
            },
            "queryFile": {
              "type": "string",
              "description": "Filename (relative to .github/skills/zed-agent/queries/) of the canary cluster-type detection KQL query. Required when canaryRouting.mode='cluster-type'.",
              "minLength": 1
            },
            "stampPrefixFilter": {
              "type": "array",
              "description": "KQL `where`-clause fragment (as a list of stamp-name prefixes) narrowing `StampName` to your service's canary stamps. Service-specific — values are illustrative only; supply whatever prefixes your service uses.",
              "examples": [["ea-can", "ecy", "ccy"], ["cn-can", "use-can"]],
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "commitExcel": {
      "type": "object",
      "description": "Settings for the commit-collection Excel sheet.",
      "required": ["sheetNameTemplate", "sharePointFolder", "excludeAuthors"],
      "additionalProperties": true,
      "properties": {
        "sheetNameTemplate": {
          "type": "string",
          "description": "Template for the Excel sheet tab name. Supports {{YYMM}} placeholder.",
          "minLength": 1
        },
        "sharePointFolder": {
          "type": "string",
          "description": "SharePoint document library path for uploading the Excel file.",
          "minLength": 1
        },
        "excludeAuthors": {
          "type": "array",
          "description": "Git author names to exclude from commit collection.",
          "items": { "type": "string" }
        }
      }
    },

    "sharepoint": {
      "type": "object",
      "description": "SharePoint site configuration for commit Excel uploads.",
      "required": ["sitePath"],
      "additionalProperties": true,
      "properties": {
        "sitePath": {
          "type": "string",
          "description": "SharePoint site path for Graph API (e.g., '/teams/AzureBackupDataPlane').",
          "minLength": 1
        }
      }
    },

    "notifications": {
      "type": "object",
      "description": "Email and Teams notification configuration.",
      "required": ["groups", "routing"],
      "additionalProperties": true,
      "properties": {
        "groups": {
          "type": "object",
          "description": "Named recipient groups referenced by routing rules.",
          "required": ["permanent", "teams"],
          "additionalProperties": true,
          "properties": {
            "permanent": {
              "type": "array",
              "description": "Always-notified email addresses.",
              "items": { "type": "string" }
            },
            "cc": {
              "type": "array",
              "description": "CC-line email addresses.",
              "items": { "type": "string" }
            },
            "teams": {
              "type": "array",
              "description": "Teams channel names for notifications.",
              "items": { "type": "string" }
            },
            "teamsExtended": {
              "type": "array",
              "description": "Extended Teams channel names (used for commit-request and similar broader broadcasts).",
              "items": { "type": "string" }
            }
          }
        },
        "routing": {
          "type": "object",
          "description": "Per-step notification routing. Keys are step identifiers (matching stepGates: '1-send-reminder' through '16-merge-back'). Each step may define routing for any of three outcomes: 'success', 'failure', 'halt' (where 'halt' covers both unexpected halts and approval-waiting gates). The release owner is ALWAYS added to every notification by Resolve-NotificationRecipients.ps1 — there is no per-rule includeOwner field. Any step or outcome not listed defaults to owner-only. EventKeys map into this table as follows: step-<N>-completed/skipped -> success; step-<N>-failed -> failure; step-<N>-waiting-approval -> halt; reminder -> 1-send-reminder.success; commit-request -> 4-collect-commits.success; create-r2d -> 13-create-r2d.success; ev2-stage-progress -> 15-production-rollout.success; ev2-promotion-reminder -> 15-production-rollout.halt. Generic keys (judgment, failure, halt, step-transition) are unmapped and always owner-only.",
          "additionalProperties": false,
          "properties": {
            "_comment": { "type": "string", "description": "Human-readable comment explaining the routing section." },

            "1-send-reminder":             { "type": "object", "additionalProperties": false, "properties": { "success": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "failure": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "halt": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } } } },
            "2-cut-branch":                { "type": "object", "additionalProperties": false, "properties": { "success": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "failure": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "halt": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } } } },
            "3-wait-build":                { "type": "object", "additionalProperties": false, "properties": { "success": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "failure": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "halt": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } } } },
            "4-collect-commits":           { "type": "object", "additionalProperties": false, "properties": { "success": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "failure": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "halt": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } } } },
            "5-deploy-canary":             { "type": "object", "additionalProperties": false, "properties": { "success": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "failure": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "halt": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } } } },
            "6-bvt-check":                 { "type": "object", "additionalProperties": false, "properties": { "success": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "failure": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "halt": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } } } },
            "7-rollback":                  { "type": "object", "additionalProperties": false, "properties": { "success": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "failure": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "halt": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } } } },
            "8-post-rollback-bvt":         { "type": "object", "additionalProperties": false, "properties": { "success": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "failure": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } }, "halt": { "type": "object", "additionalProperties": false, "properties": { "emailGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "ccGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } }, "teamsGroups": { "type": "array", "items": { "type": "string", "enum": ["permanent","cc","teams","teamsExtended"] } } } } } },
