{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/microsoft/ZED-Agent/.github/skills/zed-agent/release.schema.json",
  "title": "ZED Agent Release State",
  "description": "Schema for release.json — per-release runtime artifact tracking release owner, branch names, dates, build/SafeFly/EV2 identifiers, and the commit Excel URL.",
  "type": "object",
  "additionalProperties": true,
  "required": ["releaseId", "releaseOwner", "currentBranch", "previousBranch"],
  "properties": {
    "releaseId": {
      "type": "string",
      "description": "Release identifier, typically 'YYYY-MM' (e.g., '2026-04').",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "releaseOwner": {
      "type": "object",
      "required": ["alias", "email"],
      "additionalProperties": true,
      "properties": {
        "alias": {
          "type": "string",
          "description": "Release owner MS alias (the part before @microsoft.com).",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "description": "Release owner email address.",
          "format": "email",
          "minLength": 3
        },
        "displayName": { "type": "string" }
      }
    },
    "currentBranch": {
      "type": "string",
      "description": "Name of the release branch being deployed (e.g., 'Release-2604').",
      "minLength": 1
    },
    "previousBranch": {
      "type": "string",
      "description": "Name of the previous release branch (used for rollback in Step 7).",
      "minLength": 1
    },
    "branchCutDate":     { "type": "string", "format": "date-time" },
    "buildId":           { "type": ["integer", "string"] },
    "buildNumber":       { "type": "string" },
    "commitExcelUrl":    { "type": "string", "format": "uri" },
    "safeFlyId":         { "type": "string" },
    "safeFlyRequestNumber": { "type": ["string", "integer"] },
    "safeFlyUrl":        { "type": "string", "format": "uri" },
    "safeFlyStatus":     { "type": "string" },
    "mergeBackPrId":     { "type": ["integer", "string"] },
    "testMode":          { "type": "boolean" }
  }
}
