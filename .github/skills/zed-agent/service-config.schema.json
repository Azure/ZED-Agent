    "safefly": {
      "type": "object",
      "description": "SafeFly change-request configuration.",
      "required": ["titleTemplate", "descriptionTemplate", "tags"],
      "additionalProperties": true,
      "properties": {
        "titleTemplate": {
          "type": "string",
          "description": "Template for SafeFly CR title. Supports {serviceName}, {serviceDisplayName}, {month}, {yy} placeholders.",
          "minLength": 1
        },
        "descriptionTemplate": {
          "type": "string",
          "description": "Template for SafeFly CR description. Supports {serviceName}, {releaseId} placeholders.",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "description": "Tags applied to the SafeFly change request.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "additionalNotifiers": {
          "type": "array",
          "description": "Extra email addresses to notify on SafeFly CR events.",
          "items": { "type": "string" }
        },
        "monitoringLink": {
          "type": "string",
          "description": "Monitoring dashboard URL (e.g., Geneva MDM monitors link).",
          "format": "uri"
        }
      }
    },

    "operational": {
      "type": "object",
      "description": "Timeouts, polling intervals, and operational parameters.",
      "required": [
        "buildTimeoutMinutes",
        "bvtWaitHours",
        "bvtQueryTimeoutMinutes",
        "excelCompletionTimeoutHours",
        "canaryBakeTimeHours",
        "reminderBeforeCutDays",
        "watcherPollIntervalSeconds",
        "watcherTestModePollIntervalSeconds",
        "watcherMaxRetries",
        "watcherTaskPrefix"
      ],
      "additionalProperties": true,
      "properties": {
        "buildTimeoutMinutes": {
          "type": "integer",
          "description": "Maximum minutes to wait for a build to complete. Default 360 (6 hours).",
          "default": 360,
          "minimum": 1
        },
        "bvtWaitHours": {
          "type": "integer",
          "description": "Hours to wait before running BVT queries after deployment.",
          "default": 24,
          "minimum": 1
        },
        "bvtQueryTimeoutMinutes": {
          "type": "integer",
          "description": "Maximum minutes for a BVT Kusto query to return results.",
          "default": 120,
          "minimum": 1
        },
        "excelCompletionTimeoutHours": {
          "type": "integer",
          "description": "Maximum hours to wait for commit Excel completion.",
          "default": 48,
          "minimum": 1
        },
        "canaryBakeTimeHours": {
          "type": "integer",
          "description": "Hours to bake in canary before progressing.",
          "default": 24,
          "minimum": 1
        },
        "reminderBeforeCutDays": {
          "type": "integer",
          "description": "Days before branch cut date to send the reminder.",
          "default": 2,
          "minimum": 0
        },
        "watcherPollIntervalSeconds": {
          "type": "integer",
          "description": "Seconds between watcher poll cycles in production mode.",
          "default": 3600,
          "minimum": 60
        },
        "watcherTestModePollIntervalSeconds": {
          "type": "integer",
          "description": "Seconds between watcher poll cycles in test mode.",
          "default": 1800,
          "minimum": 60
        },
        "watcherMaxRetries": {
          "type": "integer",
          "description": "Maximum consecutive retries for transient watcher failures.",
          "default": 3,
          "minimum": 0
        },
        "watcherTaskPrefix": {
          "type": "string",
          "description": "Prefix for watcher scheduled-task names.",
          "default": "ZED-ReleaseWatcher",
          "minLength": 1
        },
        "regionMappingRepo": {
          "type": "string",
          "description": "ADO repository containing AzureServiceConfig.json for region mapping.",
          "default": "Mgmt-RecoverySvcs-DeploymentExtn"
        },
        "regionMappingPath": {
          "type": "string",
          "description": "File path within the region mapping repo.",
          "default": "src/DeploymentInfra/EV2DeploymentEngine/SchemaInput/AzureServiceConfig.json"
        },
        "regionMappingBranch": {
          "type": "string",
          "description": "Branch to read region mapping from.",
          "default": "develop"
        }
      }
    },

    "stepGates": {
      "type": "object",
      "description": "Per-step approval gates. true = owner must approve before next step. false = auto-advance.",
      "required": [
        "1-send-reminder",
        "2-cut-branch",
        "3-wait-build",
        "4-collect-commits",
        "5-deploy-canary",
        "6-bvt-check",
        "7-rollback",
        "8-post-rollback-bvt",
        "9-post-rollback-signoff",
        "10-roll-forward",
        "11-post-rollforward-bvt",
        "12-post-rollforward-signoff",
        "13-create-r2d",
        "14-crb-review",
        "15-production-rollout",
        "16-merge-back"
      ],
      "additionalProperties": true,
      "properties": {
        "_comment": {
          "type": "string",
          "description": "Human-readable comment explaining the stepGates section."
        },
        "1-send-reminder":             { "type": "boolean", "default": false },
        "2-cut-branch":                { "type": "boolean", "default": false },
        "3-wait-build":                { "type": "boolean", "default": false },
        "4-collect-commits":           { "type": "boolean", "default": false },
        "5-deploy-canary":             { "type": "boolean", "default": false },
        "6-bvt-check":                 { "type": "boolean", "default": true },
        "7-rollback":                  { "type": "boolean", "default": false },
        "8-post-rollback-bvt":         { "type": "boolean", "default": false },
        "9-post-rollback-signoff":     { "type": "boolean", "default": true },
        "10-roll-forward":             { "type": "boolean", "default": false },
        "11-post-rollforward-bvt":     { "type": "boolean", "default": false },
        "12-post-rollforward-signoff": { "type": "boolean", "default": true },
        "13-create-r2d":               { "type": "boolean", "default": false },
        "14-crb-review":               { "type": "boolean", "default": true },
        "15-production-rollout":       { "type": "boolean", "default": false },
        "16-merge-back":               { "type": "boolean", "default": false }
      }
    },

    "inventory": {
      "type": "object",
      "description": "Stamp/region inventory overrides. Populated by setup-service. The production inventory is always live-queried from Kusto by Get-StampInventory.ps1; the canary inventory is owner-curated here (canary set is small and stable — one DC in the Canary cloud, today).",
      "additionalProperties": true,
      "properties": {
        "canary": {
          "type": "object",
          "description": "Owner-curated canary stamp inventory. Get-StampInventory.ps1 (-Scope canary) reads this block instead of querying Kusto. Cross-checked against fixtures/AzureServiceConfig.snapshot.json (Canary cloud) for region/layout validity.",
          "required": ["cloud", "layout", "regions", "stamps"],
          "additionalProperties": true,
          "properties": {
            "cloud": {
              "type": "string",
              "description": "Cloud Name as it appears in AzureServiceConfig.json → Clouds[].Name.",
              "default": "Canary",
              "minLength": 1
            },
            "layout": {
              "type": "string",
              "description": "Cloud Layout (stamp-name middle segment) as it appears in AzureServiceConfig.json → Clouds[].Layout. Must match the cloud entry.",
              "default": "can02",
              "pattern": "^[a-z0-9]+$"
            },
            "regions": {
              "type": "array",
              "description": "ShortName values from AzureServiceConfig.json → Clouds[Canary].DataCenters[].ShortName that this service deploys into. Typically a single entry for canary.",
              "items": { "type": "string", "pattern": "^[a-z0-9]+$" },
              "minItems": 1,
              "examples": [["ea"]]
            },
            "stamps": {
              "type": "array",
              "description": "All canary stamps for this service. Each entry MUST parse as `{shortName}-{layout}-{stampTag}{index}` where shortName ∈ regions, layout == this.layout, stampTag == service.stampTag.",
              "items": {
                "type": "object",
                "required": ["stampName", "clusterType"],
                "additionalProperties": true,
                "properties": {
                  "stampName": {
                    "type": "string",
                    "description": "Full stamp identifier as it appears in Kusto / EV2 (e.g. 'ea-can02-prot1').",
                    "pattern": "^[a-z0-9]+-[a-z0-9]+-[a-z]+[a-z0-9]+$"
                  },
                  "clusterType": {
                    "type": "string",
                    "description": "Cluster type token consumed by pipeline-catalog.json → canaryRouting.clusterTypeMap (e.g. 'sfrp', 'sfmc', 'eap', 'aks').",
                    "minLength": 1
                  },
                  "notes": {
                    "type": "string",
                    "description": "Free-text annotation (owner, decommission date, etc.)."
                  }
                }
              },
              "minItems": 1
            }
          }
        }
      }
    },

    "agentFeedbackEmail": {
      "type": "string",
      "description": "Email address that receives feedback about the ZED agent itself. Hardcoded to the agent author; do not change.",
      "default": "gwazire@microsoft.com"
    }
  }
}
